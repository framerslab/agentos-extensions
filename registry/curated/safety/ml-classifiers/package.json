{
  "name": "@framers/agentos-ext-ml-classifiers",
  "version": "0.2.1",
  "description": "Content classifier guardrail for AgentOS \u2014 one local English toxicity model (toxic-bert, ONNX), with an LLM judge or keyword patterns as fallbacks",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@framers/agentos": ">=0.10.40"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.0.0"
  },
  "license": "Apache-2.0",
  "author": "Frame.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framerslab/agentos-extensions.git",
    "directory": "registry/curated/safety/ml-classifiers"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@framers/agentos": "^0.16.0",
    "@types/node": "^20.0.0",
    "semantic-release": "^25.0.9",
    "@semantic-release/github": "^12.0.10",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "homepage": "https://github.com/framerslab/agentos-extensions/tree/master/registry/curated/safety/ml-classifiers#readme",
  "bugs": {
    "url": "https://github.com/framerslab/agentos-extensions/issues"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
