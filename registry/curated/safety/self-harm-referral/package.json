{
  "name": "@framers/agentos-ext-self-harm-referral",
  "version": "0.1.0",
  "description": "Input and output guardrail for AgentOS that answers a self-harm expression with crisis lines by locale, does not continue the topic, and reports each referral to the host",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./referral-lines.json": "./dist/referral-lines.json",
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "agentos",
    "extension",
    "guardrail",
    "safety",
    "self-harm",
    "crisis",
    "referral"
  ],
  "author": {
    "name": "Frame",
    "email": "team@frame.dev",
    "url": "https://frame.dev"
  },
  "contributors": [
    {
      "name": "Johnny Dunn",
      "email": "johnnyfived@protonmail.com",
      "url": "https://github.com/jddunn"
    }
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framerslab/agentos-extensions.git",
    "directory": "registry/curated/safety/self-harm-referral"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@framers/agentos": ">=0.13.121"
  },
  "devDependencies": {
    "@framers/agentos": "^0.17.1",
    "@types/node": "^20.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "homepage": "https://github.com/framerslab/agentos-extensions/tree/master/registry/curated/safety/self-harm-referral#readme",
  "bugs": {
    "url": "https://github.com/framerslab/agentos-extensions/issues"
  },
  "files": [
    "dist",
    "manifest.json",
    "README.md"
  ]
}
