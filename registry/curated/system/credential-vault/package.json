    "test:watch": "vitest watch",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@framers/agentos": "^0.9.156"
  },
  "devDependencies": {
    "@framers/agentos": "workspace:^",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framerslab/agentos-extensions.git",
    "directory": "registry/curated/system/credential-vault"
  },
  "homepage": "https://github.com/framerslab/agentos-extensions/tree/master/registry/curated/system/credential-vault#readme",
  "bugs": {
    "url": "https://github.com/framerslab/agentos-extensions/issues"
  }
