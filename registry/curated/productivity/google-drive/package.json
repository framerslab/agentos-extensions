{
  "name": "@framers/agentos-ext-google-drive",
  "version": "1.2.0",
  "description": "Google Drive files a person picked, read under the drive.file scope: Google's grant on AgentOS's redirect OAuth flow, Drive's calls and an account source connector",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc --out docs src/index.ts",
    "clean": "rimraf dist"
  },
  "keywords": [
    "agentos",
    "google-drive",
    "oauth",
    "sources",
    "connectors"
  ],
  "author": {
    "name": "Frame",
    "email": "team@frame.dev",
    "url": "https://frame.dev"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framerslab/agentos-extensions.git",
    "directory": "registry/curated/productivity/google-drive"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "@framers/agentos": ">=0.13.144",
    "@framers/agentos-ext-account-sources": ">=0.8.0"
  },
  "devDependencies": {
    "@framers/agentos": "workspace:^",
    "@framers/agentos-ext-account-sources": "workspace:^",
    "@framers/sql-storage-adapter": "^0.6.14",
    "@types/node": "^20.12.12",
    "@vitest/coverage-v8": "^3.2.7",
    "rimraf": "^5.0.7",
    "typedoc": "^0.28.20",
    "typescript": "^5.4.5",
    "vitest": "^3.2.7"
  },
  "homepage": "https://github.com/framerslab/agentos-extensions/tree/master/registry/curated/productivity/google-drive#readme",
  "bugs": {
    "url": "https://github.com/framerslab/agentos-extensions/issues"
  },
  "files": [
    "dist",
    "manifest.json"
  ]
}
