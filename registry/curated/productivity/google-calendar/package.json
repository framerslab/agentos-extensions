{
  "name": "@framers/agentos-ext-calendar-google",
  "version": "1.0.3",
  "description": "Google Calendar for AgentOS: event tools through googleapis, and a typed read surface on fetch for a host that keeps its own grant",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./reader": { "types": "./dist/reader/index.d.ts", "import": "./dist/reader/index.js" },
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "agentos",
    "extension",
    "calendar",
    "google",
    "productivity"
  ],
  "author": {
    "name": "Framers AI",
    "url": "https://frame.dev"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "manifest.json"
  ],
  "publishConfig": { "access": "public" },
  "peerDependencies": {
    "@framers/agentos": ">=0.13.144",
    "@framers/agentos-ext-account-sources": ">=0.10.0"
  },
  "dependencies": {
    "@framers/agentos-ext-google-drive": "workspace:^",
    "googleapis": "^183.0.0"
  },
  "devDependencies": {
    "@framers/agentos": "workspace:^",
    "@framers/agentos-ext-account-sources": "workspace:^",
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framerslab/agentos-extensions.git",
    "directory": "registry/curated/productivity/google-calendar"
  },
  "homepage": "https://github.com/framerslab/agentos-extensions/tree/master/registry/curated/productivity/google-calendar#readme",
  "bugs": {
    "url": "https://github.com/framerslab/agentos-extensions/issues"
  }
}
