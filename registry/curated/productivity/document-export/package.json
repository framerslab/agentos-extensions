{
  "name": "@framers/agentos-ext-document-export",
  "version": "0.2.0",
  "description": "Generate PDF, DOCX, PPTX, CSV, and XLSX documents with charts, tables, and themes",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./transcript": {
      "import": "./dist/transcript/index.js",
      "types": "./dist/transcript/index.d.ts"
    },
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "keywords": [
    "agentos",
    "extension",
    "document",
    "pdf",
    "docx",
    "pptx",
    "csv",
    "xlsx",
    "export"
  ],
  "author": {
    "name": "Framers AI",
    "url": "https://frame.dev"
  },
  "contributors": [
    {
      "name": "Johnny Dunn",
      "email": "johnnyfived@protonmail.com",
      "url": "https://github.com/jddunn"
    }
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framerslab/agentos-extensions.git",
    "directory": "registry/curated/productivity/document-export"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "manifest.json"
  ],
  "peerDependencies": {
    "@framers/agentos": ">=0.10.40"
  },
  "dependencies": {
    "csv-stringify": "^6.7.0",
    "docx": "^9.6.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "pdfkit": "^0.18.0",
    "pptxgenjs": "^4.0.0"
  },
  "devDependencies": {
    "@framers/agentos": "workspace:^",
    "@types/node": "^20.12.12",
    "@types/pdfkit": "^0.17.5",
    "fast-xml-parser": "^5.11.2",
    "rimraf": "^5.0.7",
    "typescript": "^5.4.5",
    "vitest": "^3.2.7"
  },
  "homepage": "https://github.com/framerslab/agentos-extensions/tree/master/registry/curated/productivity/document-export#readme",
  "bugs": {
    "url": "https://github.com/framerslab/agentos-extensions/issues"
  }
}
