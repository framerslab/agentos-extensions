{
  "$schema": "https://agentos.sh/schemas/extension-manifest-v1.json",
  "id": "com.framers.research.web-search",
  "name": "Web Search Extension",
  "version": "1.3.3",
  "description": "Multi-provider web search for AgentOS: by default the first configured provider that answers (Serper, Tavily, Brave, SerpAPI, Firecrawl, SearXNG, then DuckDuckGo); with multiSearch, every configured provider and DuckDuckGo in parallel, deduplicated by URL and ranked by cross-provider agreement; plus research aggregation and fact-checking",
  "author": {
    "name": "Frame.dev",
    "email": "support@frame.dev",
    "url": "https://github.com/framerslab"
  },
  "license": "Apache-2.0",
  "keywords": ["search", "web", "research", "fact-check", "firecrawl", "tavily", "serper", "serpapi", "brave", "searxng", "duckduckgo"],
  "agentosVersion": ">=0.10.40",
  "categories": ["productivity", "research"],
  "repository": {
    "type": "git",
    "url": "https://github.com/framerslab/agentos-extensions"
  },
  "extensions": [
    {
      "kind": "tool",
      "id": "web_search",
      "displayName": "Web Search",
      "description": "Search the web for information",
      "entry": "./dist/tools/webSearch.js"
    },
    {
      "kind": "tool",
      "id": "research_aggregate",
      "displayName": "Research Aggregator",
      "description": "Aggregate research from multiple searches",
      "entry": "./dist/tools/researchAggregator.js"
    },
    {
      "kind": "tool",
      "id": "fact_check",
      "displayName": "Fact Checker",
      "description": "Verify facts across multiple sources",
      "entry": "./dist/tools/factCheck.js"
    }
  ],
  "configuration": {
    "properties": {
      "search.provider": {
        "type": "string",
        "enum": ["serper", "serpapi", "brave", "searxng", "duckduckgo"],
        "default": "duckduckgo",
        "description": "Search API provider to use"
      },
      "search.apiKey": {
        "type": "string",
        "description": "API key for the search provider",
        "secret": true
      },
      "search.rateLimit": {
        "type": "number",
        "default": 5,
        "minimum": 1,
        "maximum": 20,
        "description": "Maximum requests per second"
      },
      "search.multiSearch": {
        "type": "boolean",
        "default": false,
        "description": "Default multi-provider parallel search for all search tools. When enabled, queries fan out to ALL available providers, results are deduplicated by URL and ordered by cross-provider agreement and position."
      }
    }
  }
}
