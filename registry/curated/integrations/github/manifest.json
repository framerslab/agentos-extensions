{
  "$schema": "https://agentos.sh/schemas/extension-manifest-v1.json",
  "id": "com.framers.integrations.github",
  "name": "GitHub Extension",
  "version": "0.4.0",
  "description": "GitHub API tools: 26 tools for repos, issues, PRs, branches, commits, releases, Actions, files, gists, and codebase indexing. Its ./documents entry adds a GitHub App's installation mode (the app's JWT, installation tokens, the user's web flow, webhook deliveries checked and read as typed events, a daily reconcile, every call under a deadline with rate limit timing) and a connector that reads a repository's documentation as account sources.",
  "categories": ["tool", "developer"],
  "extensions": [
    { "kind": "tool", "id": "github_search", "displayName": "GitHub Search" },
    { "kind": "tool", "id": "github_issue_list", "displayName": "List GitHub Issues" },
    { "kind": "tool", "id": "github_issue_create", "displayName": "Create GitHub Issue" },
    { "kind": "tool", "id": "github_pr_list", "displayName": "List GitHub PRs" },
    { "kind": "tool", "id": "github_pr_create", "displayName": "Create GitHub PR" },
    { "kind": "tool", "id": "github_file_read", "displayName": "Read GitHub File" },
    { "kind": "tool", "id": "github_gist_create", "displayName": "Create GitHub Gist" },
    { "kind": "tool", "id": "github_repo_list", "displayName": "GitHub Repo List" },
    { "kind": "tool", "id": "github_repo_info", "displayName": "GitHub Repo Info" },
    { "kind": "tool", "id": "github_repo_create", "displayName": "GitHub Repo Create" },
    { "kind": "tool", "id": "github_repo_index", "displayName": "GitHub Repo Index" },
    { "kind": "tool", "id": "github_file_write", "displayName": "GitHub File Write" },
    { "kind": "tool", "id": "github_branch_list", "displayName": "GitHub Branch List" },
    { "kind": "tool", "id": "github_branch_create", "displayName": "GitHub Branch Create" },
    { "kind": "tool", "id": "github_commit_list", "displayName": "GitHub Commit List" },
    { "kind": "tool", "id": "github_issue_update", "displayName": "GitHub Issue Update" },
    { "kind": "tool", "id": "github_comment_list", "displayName": "GitHub Comment List" },
    { "kind": "tool", "id": "github_pr_diff", "displayName": "GitHub PR Diff" },
    { "kind": "tool", "id": "github_pr_review", "displayName": "GitHub PR Review" },
    { "kind": "tool", "id": "github_pr_merge", "displayName": "GitHub PR Merge" },
    { "kind": "tool", "id": "github_pr_comment_list", "displayName": "GitHub PR Comment List" },
    { "kind": "tool", "id": "github_pr_comment_create", "displayName": "GitHub PR Comment Create" },
    { "kind": "tool", "id": "github_release_list", "displayName": "GitHub Release List" },
    { "kind": "tool", "id": "github_release_create", "displayName": "GitHub Release Create" },
    { "kind": "tool", "id": "github_actions_list", "displayName": "GitHub Actions List" },
    { "kind": "tool", "id": "github_actions_trigger", "displayName": "GitHub Actions Trigger" }
  ],
  "requiredSecrets": ["github.token"],
  "features": [
    "Repository, code, and issue search",
    "Repository listing, info, creation, and codebase indexing",
    "Issue listing, creation, and updating",
    "Pull request listing, creation, diff, review, merge, and comments",
    "Branch listing and creation",
    "Commit history listing",
    "File reading and writing",
    "Release listing and creation",
    "GitHub Actions workflow listing and triggering",
    "Gist creation",
    "GitHub App installation mode: app JWT, installation tokens, the user's web flow, installations and repositories a user can reach, webhook signatures, daily reconcile",
    "Webhook deliveries read as typed events: pushes, installation actions, repositories added and removed, accounts renamed",
    "Every REST call under a deadline, answers read under a cap, rate limits answered with the time to try again",
    "Repository documentation as account sources, read by tree with raw file reads and compared by tree on a push"
  ]
}
