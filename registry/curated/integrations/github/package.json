{
  "name": "@framers/agentos-ext-github",
  "version": "0.10.0",
  "type": "module",
  "description": "GitHub API tools for AgentOS — search repos/code, manage issues/PRs, read files, create gists",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./documents": {
      "import": "./dist/documents/index.js",
      "types": "./dist/documents/index.d.ts"
    },
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "agentos",
    "extension",
    "github",
    "octokit",
    "developer"
  ],
  "author": {
    "name": "Framers AI",
    "url": "https://frame.dev"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "manifest.json"
  ],
  "dependencies": {
    "@octokit/rest": "^22.0.1"
  },
  "peerDependencies": {
    "@framers/agentos": ">=0.13.144",
    "@framers/agentos-ext-account-sources": ">=0.9.0"
  },
  "devDependencies": {
    "@framers/agentos": "workspace:^",
    "@framers/agentos-ext-account-sources": "workspace:^",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framerslab/agentos-extensions.git",
    "directory": "registry/curated/integrations/github"
  },
  "homepage": "https://github.com/framerslab/agentos-extensions/tree/master/registry/curated/integrations/github#readme",
  "bugs": {
    "url": "https://github.com/framerslab/agentos-extensions/issues"
  }
}
