{
  "name": "@framers/agentos-ext-channel-mastodon",
  "version": "0.1.3",
  "description": "Mastodon channel adapter for AgentOS \u2014 post statuses, reply, boost, favourite, search, trending, follow, and engagement analytics via the Mastodon API.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "manifest.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@framers/agentos": ">=0.10.40"
  },
  "dependencies": {
    "masto": "^8.0.0"
  },
  "devDependencies": {
    "@framers/agentos": "workspace:^",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framerslab/agentos-extensions.git",
    "directory": "registry/curated/channels/mastodon"
  },
  "homepage": "https://github.com/framerslab/agentos-extensions/tree/master/registry/curated/channels/mastodon#readme",
  "bugs": {
    "url": "https://github.com/framerslab/agentos-extensions/issues"
  }
}
