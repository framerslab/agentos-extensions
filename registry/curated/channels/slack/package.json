{
  "name": "@framers/agentos-ext-channel-slack",
  "version": "0.2.0",
  "description": "Slack messaging channel adapter for AgentOS: bidirectional messaging via @slack/bolt, and posting to a person's own incoming webhook or workflow link",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./outbound": {
      "types": "./dist/outbound/index.d.ts",
      "default": "./dist/outbound/index.js"
    },
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "agentos",
    "extension",
    "channel",
    "slack",
    "bolt",
    "messaging"
  ],
  "author": {
    "name": "Framers AI",
    "url": "https://frame.dev"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "manifest.json"
  ],
  "peerDependencies": {
    "@framers/agentos": ">=0.10.40"
  },
  "dependencies": {
    "@slack/bolt": "^5.1.0"
  },
  "devDependencies": {
    "@framers/agentos": "workspace:^",
    "@types/node": "^20.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framerslab/agentos-extensions.git",
    "directory": "registry/curated/channels/slack"
  },
  "homepage": "https://github.com/framerslab/agentos-extensions/tree/master/registry/curated/channels/slack#readme",
  "bugs": {
    "url": "https://github.com/framerslab/agentos-extensions/issues"
  }
}
