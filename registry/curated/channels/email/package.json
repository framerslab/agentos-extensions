{
  "name": "@framers/agentos-ext-channel-email",
  "version": "0.5.0",
  "description": "Email channel adapter for AgentOS: send through SMTP or Resend's HTTPS API; read, search, extract codes, reply, move, label, flag and delete through IMAP; keep a suppression record and unsubscribe tokens on a SQL database.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "manifest.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@framers/agentos": ">=0.10.40"
  },
  "peerDependenciesMeta": {
    "@framers/agentos": {
      "optional": true
    }
  },
  "dependencies": {
    "imapflow": "^1.0.0",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "@framers/agentos": "workspace:^",
    "@framers/sql-storage-adapter": "^0.8.3",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framerslab/agentos-extensions.git",
    "directory": "registry/curated/channels/email"
  },
  "homepage": "https://github.com/framerslab/agentos-extensions/tree/master/registry/curated/channels/email#readme",
  "bugs": {
    "url": "https://github.com/framerslab/agentos-extensions/issues"
  }
}
