{
  "input": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "filmId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "The film id, as wildweave_film_list returns it"
      },
      "sceneId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "description": "A scene id of the timeline, such as s02"
      },
      "kind": {
        "type": "string",
        "enum": [
          "clip",
          "meme",
          "mark",
          "split",
          "other"
        ]
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "\\S"
      },
      "body": {
        "type": "string",
        "maxLength": 4000
      },
      "rights": {
        "type": "object",
        "properties": {
          "basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S",
            "description": "The rights basis, such as own footage, licensed or fair use"
          },
          "holder": {
            "type": "string",
            "maxLength": 200
          },
          "licence": {
            "type": "string",
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "maxLength": 2048
          },
          "attribution": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "basis"
        ],
        "additionalProperties": false
      },
      "assetRef": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "by": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "\\S",
        "description": "The role proposing it, such as film-memes"
      },
      "proposalId": {
        "description": "The proposal's id, a UUID; the tool names one when you give none. The same id with the same body answers the proposal that stands (replayed: true) instead of storing a second one; the id under another body answers proposal_id_reused",
        "type": "string",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "required": [
      "filmId",
      "sceneId",
      "kind",
      "title",
      "body",
      "rights",
      "by"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "result": {
            "type": "object",
            "properties": {
              "proposal": {
                "type": "object",
                "properties": {
                  "proposalId": {
                    "type": "string"
                  },
                  "filmId": {
                    "type": "string"
                  },
                  "sceneId": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "rights": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "assetRef": {
                    "type": "string"
                  },
                  "by": {
                    "type": "string"
                  },
                  "submittedAtMs": {
                    "type": "number"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "proposed",
                      "yes",
                      "no",
                      "noted"
                    ]
                  },
                  "verdict": {
                    "type": "object",
                    "properties": {
                      "words": {
                        "type": "string"
                      },
                      "source": {
                        "type": "string",
                        "enum": [
                          "app",
                          "relayed"
                        ]
                      },
                      "decidedAtMs": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": {}
                  }
                },
                "additionalProperties": {}
              },
              "replayed": {
                "type": "boolean",
                "description": "True when the studio held this proposal already: a retry of the same submit, which stored nothing"
              }
            },
            "additionalProperties": {}
          },
          "requestId": {
            "type": "string"
          },
          "records": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ok",
          "result"
        ],
        "additionalProperties": {}
      },
      {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "The refusal code, such as key_missing, engine_missing, stale_write, edit_refused, not_open"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "description": "The route's HTTP status",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "requestId": {
                "type": "string"
              },
              "findings": {
                "type": "array",
                "items": {}
              },
              "sceneId": {
                "type": "string"
              },
              "details": {
                "description": "The rest of the route's answer, such as stale_write's current edit times",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": {}
      }
    ]
  }
}
