{
  "input": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "film": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "description": "The film repository; WILDWEAVE_FILM_REPO by default"
      },
      "out": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "description": "The folder whose reports/ the import plan and report go to"
      },
      "target": {
        "type": "string",
        "enum": [
          "dry-run",
          "local",
          "production"
        ],
        "description": "dry-run plans and writes nothing; production imports into the account with the studio key"
      },
      "force": {
        "description": "Write over documents edited in WildWeave since the import (conflict otherwise); his decision, never a default",
        "type": "boolean"
      },
      "exportCheck": {
        "type": "boolean"
      }
    },
    "required": [
      "out",
      "target"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "result": {
            "type": "object",
            "properties": {},
            "additionalProperties": {},
            "description": "The command's result, passed through as it printed it"
          },
          "requestId": {
            "type": "string"
          },
          "records": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ok",
          "result"
        ],
        "additionalProperties": {}
      },
      {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "The refusal code, such as key_missing, engine_missing, stale_write, edit_refused, not_open"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "description": "The route's HTTP status",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "requestId": {
                "type": "string"
              },
              "findings": {
                "type": "array",
                "items": {}
              },
              "sceneId": {
                "type": "string"
              },
              "details": {
                "description": "The rest of the route's answer, such as stale_write's current edit times",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": {}
      }
    ]
  }
}
