{
  "input": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "filmId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "The film id, as wildweave_film_list returns it"
      },
      "writeTo": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "description": "Write the sources into this folder of the film repository (the repository root, or a folder inside it); without it the texts are only returned"
      },
      "force": {
        "description": "Write a source whose file changed in the repository since the last crossing (source_changed otherwise); his decision, never a default",
        "type": "boolean"
      },
      "paths": {
        "description": "Each source's path relative to writeTo, where the repository keeps it elsewhere than the default layout",
        "type": "object",
        "properties": {
          "script": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "beatSheet": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "takes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "timeline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sidecar": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "additionalProperties": false
      }
    },
    "required": [
      "filmId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "result": {
            "type": "object",
            "properties": {
              "recordFormat": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "sources": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "description": "Left out when the tool wrote the sources into the repository"
                    },
                    "sha256": {
                      "type": "string"
                    },
                    "baseSha256": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "changed": {
                      "type": "boolean"
                    },
                    "notes": {
                      "type": "array",
                      "items": {}
                    }
                  },
                  "additionalProperties": {}
                }
              },
              "written": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "enum": [
                        "script",
                        "beatSheet",
                        "takes",
                        "timeline",
                        "sidecar"
                      ]
                    },
                    "path": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string"
                    },
                    "forced": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": {}
                }
              },
              "unchanged": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "script",
                    "beatSheet",
                    "takes",
                    "timeline",
                    "sidecar"
                  ]
                }
              },
              "validated": {
                "type": "boolean",
                "description": "True when the local engine cut and validated the written set before it was moved into place"
              },
              "ack": {
                "type": "object",
                "properties": {
                  "seq": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sources": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "rebound": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": {}
              }
            },
            "additionalProperties": {}
          },
          "requestId": {
            "type": "string"
          },
          "records": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ok",
          "result"
        ],
        "additionalProperties": {}
      },
      {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "The refusal code, such as key_missing, engine_missing, stale_write, edit_refused, not_open"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "description": "The route's HTTP status",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "requestId": {
                "type": "string"
              },
              "findings": {
                "type": "array",
                "items": {}
              },
              "sceneId": {
                "type": "string"
              },
              "details": {
                "description": "The rest of the route's answer, such as stale_write's current edit times",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": {}
      }
    ]
  }
}
