{
  "input": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "filmId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "The film id, as wildweave_film_list returns it"
      },
      "proposalId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "verdict": {
        "type": "string",
        "enum": [
          "yes",
          "no",
          "note"
        ]
      },
      "words": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "\\S",
        "description": "His words, verbatim"
      },
      "source": {
        "type": "string",
        "enum": [
          "app",
          "relayed"
        ],
        "description": "relayed: the session relays a message of his; app is his own session in the app, refused for a studio key (source_app_needs_session)"
      }
    },
    "required": [
      "filmId",
      "proposalId",
      "verdict",
      "words",
      "source"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "result": {
            "type": "object",
            "properties": {
              "proposal": {
                "type": "object",
                "properties": {
                  "proposalId": {
                    "type": "string"
                  },
                  "filmId": {
                    "type": "string"
                  },
                  "sceneId": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "rights": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "assetRef": {
                    "type": "string"
                  },
                  "by": {
                    "type": "string"
                  },
                  "submittedAtMs": {
                    "type": "number"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "proposed",
                      "yes",
                      "no",
                      "noted"
                    ]
                  },
                  "verdict": {
                    "type": "object",
                    "properties": {
                      "words": {
                        "type": "string"
                      },
                      "source": {
                        "type": "string",
                        "enum": [
                          "app",
                          "relayed"
                        ]
                      },
                      "decidedAtMs": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": {}
                  }
                },
                "additionalProperties": {}
              }
            },
            "additionalProperties": {}
          },
          "requestId": {
            "type": "string"
          },
          "records": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ok",
          "result"
        ],
        "additionalProperties": {}
      },
      {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "The refusal code, such as key_missing, engine_missing, stale_write, edit_refused, not_open"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "description": "The route's HTTP status",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "requestId": {
                "type": "string"
              },
              "findings": {
                "type": "array",
                "items": {}
              },
              "sceneId": {
                "type": "string"
              },
              "details": {
                "description": "The rest of the route's answer, such as stale_write's current edit times",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": {}
      }
    ]
  }
}
