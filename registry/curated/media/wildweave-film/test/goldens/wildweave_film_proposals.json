{
  "input": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "filmId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "The film id, as wildweave_film_list returns it"
      },
      "status": {
        "type": "string",
        "enum": [
          "proposed",
          "yes",
          "no",
          "noted"
        ]
      }
    },
    "required": [
      "filmId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "result": {
            "type": "object",
            "properties": {
              "proposals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "proposalId": {
                      "type": "string"
                    },
                    "filmId": {
                      "type": "string"
                    },
                    "sceneId": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "body": {
                      "type": "string"
                    },
                    "rights": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "assetRef": {
                      "type": "string"
                    },
                    "by": {
                      "type": "string"
                    },
                    "submittedAtMs": {
                      "type": "number"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "proposed",
                        "yes",
                        "no",
                        "noted"
                      ]
                    },
                    "verdict": {
                      "type": "object",
                      "properties": {
                        "words": {
                          "type": "string"
                        },
                        "source": {
                          "type": "string",
                          "enum": [
                            "app",
                            "relayed"
                          ]
                        },
                        "decidedAtMs": {
                          "type": "number"
                        }
                      },
                      "additionalProperties": {}
                    }
                  },
                  "additionalProperties": {}
                }
              }
            },
            "additionalProperties": {}
          },
          "requestId": {
            "type": "string"
          },
          "records": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ok",
          "result"
        ],
        "additionalProperties": {}
      },
      {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "The refusal code, such as key_missing, engine_missing, stale_write, edit_refused, not_open"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "description": "The route's HTTP status",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "requestId": {
                "type": "string"
              },
              "findings": {
                "type": "array",
                "items": {}
              },
              "sceneId": {
                "type": "string"
              },
              "details": {
                "description": "The rest of the route's answer, such as stale_write's current edit times",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "refusal": {
                "description": "The gate's envelope beside the code: the account's plan or room decides it, so the call is never sent again as it is",
                "type": "object",
                "properties": {
                  "capability": {
                    "type": "string"
                  },
                  "tier": {
                    "type": "string"
                  },
                  "requiredPlan": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "upgradeUrl": {
                    "type": "string"
                  },
                  "limit": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": {}
                  },
                  "checkoutPaused": {
                    "type": "boolean"
                  },
                  "policyVersion": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": {}
      }
    ]
  }
}
