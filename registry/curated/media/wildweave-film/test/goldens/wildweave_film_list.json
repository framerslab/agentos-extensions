{
  "input": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "output": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "result": {
            "type": "object",
            "properties": {
              "films": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "filmId": {
                      "type": "string"
                    },
                    "bookId": {
                      "type": "string"
                    },
                    "storyboardId": {
                      "type": "string"
                    },
                    "recordId": {
                      "type": "string"
                    },
                    "takesId": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "importedAtMs": {
                      "type": "number"
                    },
                    "bundleSha256": {
                      "type": "string"
                    },
                    "scenes": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "totalMs": {
                      "type": "number"
                    },
                    "edited": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": {}
                }
              }
            },
            "additionalProperties": {}
          },
          "requestId": {
            "type": "string"
          },
          "records": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ok",
          "result"
        ],
        "additionalProperties": {}
      },
      {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "The refusal code, such as key_missing, engine_missing, stale_write, edit_refused, not_open"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "description": "The route's HTTP status",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "requestId": {
                "type": "string"
              },
              "findings": {
                "type": "array",
                "items": {}
              },
              "sceneId": {
                "type": "string"
              },
              "details": {
                "description": "The rest of the route's answer, such as stale_write's current edit times",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": {}
      }
    ]
  }
}
