{
  "input": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "filmId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "The film id, as wildweave_film_list returns it"
      },
      "sceneId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "description": "A scene id of the timeline, such as s02"
      }
    },
    "required": [
      "filmId",
      "sceneId"
    ],
    "additionalProperties": false
  },
  "output": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "result": {
            "type": "object",
            "properties": {
              "scene": {
                "type": "object",
                "properties": {},
                "additionalProperties": {}
              },
              "sidecar": {
                "type": "object",
                "properties": {},
                "additionalProperties": {}
              },
              "readiness": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "picture": {
                        "type": "string",
                        "enum": [
                          "ready",
                          "stale",
                          "placeholder",
                          "missing"
                        ]
                      },
                      "voice": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": "string",
                          "enum": [
                            "ready",
                            "stand-in",
                            "missing"
                          ]
                        }
                      },
                      "bed": {
                        "type": "string",
                        "enum": [
                          "ready",
                          "missing"
                        ]
                      },
                      "sound": {
                        "type": "string",
                        "enum": [
                          "ok",
                          "local-only"
                        ]
                      }
                    },
                    "required": [
                      "picture",
                      "voice",
                      "bed",
                      "sound"
                    ],
                    "additionalProperties": {}
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "level": {
                      "type": "string",
                      "enum": [
                        "error",
                        "warning",
                        "note"
                      ]
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "sceneId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "level",
                    "code",
                    "message"
                  ],
                  "additionalProperties": {},
                  "description": "A finding of the cut checker: an error refuses a render or an edit; a warning or a note does not"
                }
              }
            },
            "additionalProperties": {}
          },
          "requestId": {
            "type": "string"
          },
          "records": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ok",
          "result"
        ],
        "additionalProperties": {}
      },
      {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "The refusal code, such as key_missing, engine_missing, stale_write, edit_refused, not_open"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "description": "The route's HTTP status",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "requestId": {
                "type": "string"
              },
              "findings": {
                "type": "array",
                "items": {}
              },
              "sceneId": {
                "type": "string"
              },
              "details": {
                "description": "The rest of the route's answer, such as stale_write's current edit times",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "refusal": {
                "description": "The gate's envelope beside the code: the account's plan or room decides it, so the call is never sent again as it is",
                "type": "object",
                "properties": {
                  "capability": {
                    "type": "string"
                  },
                  "tier": {
                    "type": "string"
                  },
                  "requiredPlan": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "upgradeUrl": {
                    "type": "string"
                  },
                  "limit": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": {}
                  },
                  "checkoutPaused": {
                    "type": "boolean"
                  },
                  "policyVersion": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": {}
      }
    ]
  }
}
