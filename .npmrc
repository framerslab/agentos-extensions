# NPM Configuration for Extensions

# Use exact versions for better reproducibility
save-exact=true

# Ensure package-lock.json is used
package-lock=true

# Registry for @framers scope
@framers:registry=https://registry.npmjs.org/

# Access level for publishing
access=public

# Audit level
audit-level=moderate

# Fund message
fund=false

# Workspace packages that satisfy a dependent's range are linked, not fetched:
# a pack that depends on another pack at a version the next release publishes
# installs before that version is on the registry.
link-workspace-packages=true
# The release publishes each pack at the registry's next version without writing
# it back, so npm always holds a newer release than the workspace's manifest. pnpm
# links a satisfying workspace package over a newer registry release only with this
# set; without it, every lockfile refresh (Dependabot's, the Lockfile workflow's)
# resolves the published copy and the dependent tests against it.
prefer-workspace-packages=true
